{
  "name": "media-library-open-bench",
  "private": true,
  "type": "module",
  "description": "Synthetic benchmark: opening a media library listing on different operating systems.",
  "scripts": {
    "bench": "node bench/run.mjs",
    "bench:platform": "node bench/platform/run.mjs",
    "test:platform": "node --test bench/platform/*.test.mjs",
    "bench:extended": "node bench/extended/launch.mjs",
    "test:extended": "node --test bench/extended/*.test.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "ag-psd": "31.0.1",
    "ffmpeg-static": "5.3.0",
    "sharp": "0.34.5",
    "undici": "6.24.1"
  },
  "devDependencies": {
    "electron": "39.8.3"
  }
}
